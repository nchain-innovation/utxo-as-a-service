# Copy to .env and set real values. .env is gitignored and must not be committed.
#
# Docker Compose reads this automatically. Override the PostgreSQL superuser
# password used by the database container:
POSTGRES_PASSWORD=change-me-to-a-long-random-secret

# The connection URL both components use. The tracked configs carry a
# CHANGE-ME placeholder, so this is what supplies a real value; docker-compose
# passes it to uaas_migrate, uaas_backend and uaas_web. Leave it unset to take
# the local development default in docker-compose.yml.
UAAS_POSTGRES_URL=postgresql://uaas:uaas-password@postgres:5432/uaas_db

# NOTE: the application database roles ("uaas" / "maas") are still created with
# their passwords written into
#   init_database/postgres/01_roles_and_databases.sql
# That file runs once against the empty compose database, so the value has to
# be known at build time and cannot come from here without templating it at
# deploy time (e.g. with envsubst) and a full stack test. Until that is done,
# changing the password means changing it there and in UAAS_POSTGRES_URL
# together. Never reuse these defaults in any shared or production deployment.
# See docs/Security.md.
